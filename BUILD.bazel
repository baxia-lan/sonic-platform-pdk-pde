"""
Platform Development Environment — BUILD.bazel added on claude branch.

Migration status: Phase 1 Bazel migration.
Build type: Python setuptools → .whl + .deb
"""

load("@rules_python//python:defs.bzl", "py_library")
load("//rules/bazel/wheel:wheel.bzl", "sonic_wheel")
load("//rules/bazel/deb:deb.bzl", "deb_package_set")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**/*.py", "setup.py", "setup.cfg", "pyproject.toml",
         "debian/**/*", "*.cfg", "*.toml"],
        exclude = [".git/**", "__pycache__/**", "*.pyc"],
    ),
)

sonic_wheel(
    name = "sonic-platform-pdk-pde_wheel",
    distribution = "sonic-platform-pdk-pde",
    version = "$(PKG_VERSION)",
    deps = [":all_srcs"],
    visibility = ["//visibility:public"],
)

deb_package_set(
    name = "sonic-platform-pdk-pde_debs",
    srcs = [":all_srcs"],
    debian_dir = "debian",
    version = "$(PKG_VERSION)",
    declared_outputs = ["sonic-platform-pdk-pde.deb"],
    visibility = ["//visibility:public"],
)

